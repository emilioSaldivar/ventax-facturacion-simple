# Plantilla del stack aislado de la verificacion de capacidad.
# stack.sh init la copia a .local/carga/env.carga (permiso 600, fuera de git) y genera
# los valores aleatorios. Los datos de FE los entrega el equipo de FE (SPEC D-2).

COMPOSE_PROJECT_NAME=fs-carga

NODE_ENV=production
PORT=8080
API_BASE_PATH=/api/v1
APP_ORIGIN=http://127.0.0.1:8292
BACKOFFICE_ORIGIN=http://127.0.0.1:8292
PUBLIC_APP_BASE_URL=http://127.0.0.1:8292

API_HTTP_PORT=8291
FRONTEND_HTTP_PORT=8292
POSTGRES_HOST_PORT=5435

POSTGRES_DB=facturacion_simple
POSTGRES_USER=facturacion_simple
POSTGRES_PASSWORD=<generado-por-stack-init>
DOCKER_DB_URL=<generado-por-stack-init>
DATABASE_URL=<generado-por-stack-init>

JWT_ACCESS_SECRET=<generado-por-stack-init>
JWT_REFRESH_SECRET=<generado-por-stack-init>
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# Modo real: el unico que cuenta como evidencia (SPEC RN-04).
FE_GATEWAY_MODE=real
FE_API_ENV=test
FE_DOCKER_NETWORK=fs_carga_fiscal
FE_API_BASE_URL=<url-del-fe-aislado>
FE_API_KEY=<clave-compartida-del-fe-aislado>
FE_API_TIMEOUT_MS=20000

# Iguales a produccion (.env.production.example y defaults de env.ts).
FE_SEND_EMISSION_PROFILE_CODE=true
FE_SERVICE_NUMBERING=true
FE_OUTBOX_WORKER_ENABLED=true
FE_OUTBOX_WORKER_INTERVAL_MS=5000
FE_VERIFY_WORKER_ENABLED=true
FE_VERIFY_WORKER_INTERVAL_MS=30000
FE_VERIFY_BATCH_SIZE=10

# Correo falso interno. Nada sale del stack (SPEC RN-05).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=carga
SMTP_PASS=<generado-por-stack-init>
# RESEND_API_KEY y VENTAX_NOTIFY_EMAIL no se definen: env.ts rechaza un correo vacio y stack.sh
# aborta si alguna trae valor.

# Sin descargas del padron ni carrera sobre el bind mount.
DNIT_CRON_ENABLED=false
DNIT_RUN_ON_START=false

DOCKER_LOG_MAX_SIZE=100m
DOCKER_LOG_MAX_FILE=10
