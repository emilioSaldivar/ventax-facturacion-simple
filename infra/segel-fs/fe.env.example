# Plantilla de facturacion-electronica para segel-fs. La completa
# scripts/segel-fs/init-env.sh en el servidor: los valores __X__ no se versionan.
COMPOSE_PROJECT_NAME=fe-segel
FE_ENV_FILE=.env.segel
FE_ROOT_DIR=__ROOT__/fe-runtime

APP_ENV=__APP_ENV__
APP_TIMEZONE=America/Asuncion
APP_TRUST_PROXY=true
PORT=8080
API_BIND_IP=127.0.0.1
API_HOST_PORT=__FE_API_PORT__
FRONTEND_BIND_IP=__BIND_IP__
FRONTEND_PORT=__FE_PORT__
API_KEY=__FE_API_KEY__
API_KEY_SECRET=__FE_API_KEY_SECRET__
ADMIN_AUTH_SECRET=__FE_ADMIN_AUTH_SECRET__
CONFIG_SOURCE=db
ENABLE_DEV_SMOKE=false
JSON_BODY_LIMIT=1mb
ADMIN_AUTH_TOKEN_TTL_MINUTES=720
CORS_ALLOW_ORIGINS=https://fe-back.factura.segel.com.py

POSTGRES_DB=fe_segel
POSTGRES_USER=postgres
POSTGRES_PASSWORD=__FE_POSTGRES_PASSWORD__
DATABASE_URL=postgres://postgres:__FE_POSTGRES_PASSWORD__@postgres:5432/fe_segel
FE_BACKUP_DIR=backups/segel

SIFEN_ENV=__AMBIENTE__
SIFEN_TIMEOUT_MS=15000
SETAPI_TIMEOUT_MS=20000
SETAPI_MAX_RETRIES=3
SETAPI_RETRY_DELAY_MS=2000

BATCH_WORKER_LOOP_SECONDS=60
STATUS_SYNC_WORKER_LOOP_SECONDS=60

CERT_UPLOAD_DIR=/tmp/facturacion-electronica/certs
LOGO_UPLOAD_DIR=/tmp/facturacion-electronica/logos
FE_SECRETS_DIR=__ROOT__/fe-runtime/secrets
FE_CERT_SEED_DIR=__ROOT__/fe-runtime/runtime/cert-seed
FE_CERT_UPLOADS_DIR=__ROOT__/fe-runtime/runtime/cert-uploads
FE_LOGO_UPLOADS_DIR=__ROOT__/fe-runtime/runtime/logo-uploads

KUDE_TMP_DIR=/tmp/facturacion-electronica/kude
# assets/logo.jpeg es un logo de ejemplo ("Prototipo"); no debe imprimirse en un KuDE.
KUDE_LOGO_PATH=/app/assets/kude-logo-vacio.png
KUDE_JASPER_PATH=/app/node_modules/facturacionelectronicapy-kude/dist/DE/Factura.jasper
KUDE_JASPER_AMBIENTE=__KUDE_AMBIENTE__
KUDE_JAVA_BIN=java
KUDE_TIMEOUT_MS=30000

# La contrasena se completa a mano en el servidor. No usar el SMTP de Ventax.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply-facturacion@segel.com.py
SMTP_PASS=
SMTP_FROM_NAME="Facturacion Electronica Segel"
SMTP_FROM_EMAIL=no-reply-facturacion@segel.com.py
SMTP_REPLY_TO=no-reply-facturacion@segel.com.py

LOG_LEVEL=info

# FE-15, FE-16, FE-17 y NC con clave (segel-rc1): valores iniciales de FE, sin medir en esta VPS.
EMAIL_QUEUE_ENABLED=true
EMISSION_ADMISSION_ENABLED=true
EMISSION_RESUME_DRAFT_ENABLED=true
NCE_IDEMPOTENCY_ENABLED=true
EMAIL_QUEUE_CONCURRENCY=1
EMAIL_QUEUE_POLL_SECONDS=5
EMAIL_QUEUE_LEASE_MINUTES=10
EMISSION_MAX_CONCURRENT=2
EMISSION_MAX_QUEUE=20
EMISSION_QUEUE_WAIT_MS=5000
EMISSION_RETRY_AFTER_SECONDS=5

CONSUMER_NETWORK_NAME=segel_fiscal

PUBLIC_BASE_URL=https://app.factura.segel.com.py
# Sin host fe-api propio: el frontend de FE reenvia /v1/ a su API.
PUBLIC_API_BASE_URL=https://fe-back.factura.segel.com.py
