# Plantilla de facturacion simple para segel-fs. La completa scripts/segel-fs/init-env.sh
# en el servidor: los valores __X__ nunca se reemplazan a mano ni se versionan.
COMPOSE_PROJECT_NAME=segel-fs

NODE_ENV=production
PORT=8080
API_BASE_PATH=/api/v1
APP_ORIGIN=https://factura.segel.com.py
BACKOFFICE_ORIGIN=https://backoffice.segel.com.py
PUBLIC_APP_BASE_URL=https://factura.segel.com.py

FRONTEND_BIND_IP=__BIND_IP__
FRONTEND_HTTP_PORT=__FS_PORT__
API_HTTP_PORT=__FS_API_PORT__
POSTGRES_HOST_PORT=__PG_PORT__

POSTGRES_DB=facturacion_simple
POSTGRES_USER=facturacion_simple
POSTGRES_PASSWORD=__FS_POSTGRES_PASSWORD__
DATABASE_URL=postgres://facturacion_simple:__FS_POSTGRES_PASSWORD__@postgres:5432/facturacion_simple
DOCKER_DB_URL=postgres://facturacion_simple:__FS_POSTGRES_PASSWORD__@postgres:5432/facturacion_simple

JWT_ACCESS_SECRET=__JWT_ACCESS_SECRET__
JWT_REFRESH_SECRET=__JWT_REFRESH_SECRET__
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

FE_GATEWAY_MODE=real
FE_DOCKER_NETWORK=segel_fiscal
FE_API_BASE_URL=http://facturacion-electronica:8080/v1
FE_API_KEY=__FE_API_KEY__
FE_API_ENV=test
FE_API_TIMEOUT_MS=20000
FE_SEND_EMISSION_PROFILE_CODE=true
FE_SERVICE_NUMBERING=true
FE_OUTBOX_WORKER_ENABLED=true
FE_OUTBOX_WORKER_INTERVAL_MS=5000

DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=5

DNIT_RUN_ON_START=false
DNIT_CRON_DAY=05
DNIT_CRON_HOUR=3
DNIT_CRON_MINUTE=0

# La contrasena se completa a mano en el servidor. Mientras SMTP_PASS este vacia no se
# envia correo y el texto, incluido el OTP, queda en los logs de la API.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply-facturacion@segel.com.py
SMTP_PASS=
EMAIL_FROM=no-reply-facturacion@segel.com.py
EMAIL_FROM_NAME="Facturacion Electronica Segel"
